---
import Base from '../../layouts/Base.astro';
import { getArticles } from '../../lib/data';

const articles = await getArticles();
---

<Base title="Blog &amp; Artikel &mdash; Konveksi Nusa">
  <section class="py-24 container-page">
    <div class="max-w-3xl mb-16 space-y-4">
      <p class="eyebrow">Wawasan & Edukasi</p>
      <h1 class="font-display text-5xl font-normal text-noir-900 tracking-tight">Blog Garmen Nusa</h1>
      <p class="text-lg text-noir-700/80">Referensi bahan, teknik produksi, dan praktik terbaik untuk membuat pakaian custom yang benar-benar awet.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {articles.map((article) => (
        <article class="card p-8 space-y-4 group">
          <div class="h-56 bg-paper-200 rounded-2xl flex items-center justify-center font-display text-noir-900/30 group-hover:bg-paper-300 transition-colors">
            {article.title}
          </div>
          <div class="space-y-3">
            <span class="text-xs font-semibold text-noir-500">{article.published_date}</span>
            <h2 class="font-display text-2xl font-normal text-noir-900">
              <a href={`/blog/${article.id}`} class="hover:text-ember-600 transition">{article.title}</a>
            </h2>
            <p class="text-sm text-noir-700 leading-relaxed line-clamp-2">{article.content}</p>
            <a href={`/blog/${article.id}`} class="text-xs font-semibold text-ember-600 hover:underline mt-2 inline-block">Baca Selengkapnya &rarr;</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
