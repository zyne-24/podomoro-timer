---
import Base from '../layouts/Base.astro';
import { getProducts, getArticles } from '../lib/data';

const products = await getProducts();
const articles = await getArticles();
---

<Base title="Konveksi Nusa &mdash; Garmen & Apparel Kualitas Butik">
  
  <!-- Hero Section (Anti-Slop Asymmetric Editorial) -->
  <section class="py-20 lg:py-32 border-b border-noir-900/10 bg-gradient-to-b from-paper-100 to-paper-50">
    <div class="container-page grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-8">
        <div class="inline-flex items-center gap-2 bg-paper-200/70 border border-noir-900/10 px-3.5 py-1.5 rounded-full">
          <span class="w-2 h-2 rounded-full bg-ember-600"></span>
          <span class="text-xs font-semibold tracking-wide text-noir-800">Standar Jahitan Butik &bull; Ketepatan Waktu Terjamin</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-normal text-noir-900 tracking-tight leading-[1.1]">
          Wujudkan pakaian custom <i class="font-serif italic text-ember-600">berkualitas tinggi</i> untuk identitas Anda.
        </h1>
        <p class="text-lg text-noir-800/70 leading-relaxed max-w-xl font-sans">
          Spesialis produksi kemeja PDH organisasi, kaos event distro, dan jaket custom dengan material premium serta pengerjaan teliti dari tangan para ahli garmen lokal.
        </p>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <a href="/katalog" class="btn-primary py-4 px-8 text-base">Jelajahi Katalog</a>
          <a href="/admin" class="btn-ghost py-4 px-8 text-base">Akses Admin CMS</a>
        </div>
        <div class="grid grid-cols-3 gap-6 pt-8 border-t border-noir-900/10">
          <div>
            <p class="font-display text-3xl font-bold text-noir-900">10+</p>
            <p class="text-xs text-noir-700 font-medium uppercase tracking-wider">Tahun Pengalaman</p>
          </div>
          <div>
            <p class="font-display text-3xl font-bold text-noir-900">50K+</p>
            <p class="text-xs text-noir-700 font-medium uppercase tracking-wider">Pcs Terproduksi</p>
          </div>
          <div>
            <p class="font-display text-3xl font-bold text-noir-900">100%</p>
            <p class="text-xs text-noir-700 font-medium uppercase tracking-wider">Garansi Kualitas</p>
          </div>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="card p-8 bg-paper-100/80 backdrop-blur space-y-6">
          <p class="eyebrow">Komitmen Kami</p>
          <h3 class="font-display text-2xl font-normal text-noir-900">Bukan sekadar konveksi, ini tentang <i class="font-serif italic">presisi</i>.</h3>
          <ul class="space-y-4 text-sm text-noir-800/80">
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-ember-600 mt-2 shrink-0"></span>
              <span><strong>Kontrol Ketat:</strong> QC berlapis dari pemotongan kain hingga finishing packing.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-ember-600 mt-2 shrink-0"></span>
              <span><strong>Transparansi Harga:</strong> Kalkulasi instan tanpa biaya tersembunyi.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-ember-600 mt-2 shrink-0"></span>
              <span><strong>Konsultasi Gratis:</strong> Panduan pemilihan bahan dan teknik sablon/bordir terbaik.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Produk Unggulan (Katalog Preview) -->
  <section class="py-24 container-page">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="space-y-3">
        <p class="eyebrow">Katalog Pilihan</p>
        <h2 class="font-display text-3xl lg:text-4xl font-normal text-noir-900">Kategori Produk Utama</h2>
      </div>
      <a href="/katalog" class="text-sm font-semibold text-ember-600 hover:text-ember-700 transition flex items-center gap-1">
        Lihat Semua Katalog &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {products.slice(0, 3).map((product) => (
        <div class="card overflow-hidden flex flex-col justify-between group">
          <div class="h-60 bg-paper-200 flex items-center justify-center font-display text-noir-700/60 text-lg group-hover:bg-paper-300 transition-colors">
            {product.title}
          </div>
          <div class="p-6 space-y-4 flex-grow flex flex-col justify-between">
            <div class="space-y-2">
              <span class="inline-block text-xs font-semibold bg-paper-200 text-noir-800 px-3 py-1 rounded-full">
                Min. Order {product.min_order || 24} Pcs
              </span>
              <h3 class="font-display text-xl font-bold text-noir-900">{product.title}</h3>
              <p class="text-sm text-noir-700/80 leading-relaxed line-clamp-2">{product.description}</p>
            </div>
            <div class="pt-4 border-t border-noir-900/10 flex items-center justify-between">
              <div>
                <span class="text-xs text-noir-700 block">Mulai dari</span>
                <span class="font-display font-bold text-lg text-ember-600">Rp {Number(product.price).toLocaleString('id-ID')}</span>
              </div>
              <a href={`/katalog/${product.id}`} class="btn-ghost text-xs py-2 px-4">Detail & Pesan</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Blog & Artikel Section -->
  <section class="py-24 bg-paper-100 border-t border-noir-900/10">
    <div class="container-page">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div class="space-y-3">
          <p class="eyebrow">Wawasan & Edukasi</p>
          <h2 class="font-display text-3xl lg:text-4xl font-normal text-noir-900">Artikel & Tips Garmen</h2>
        </div>
        <a href="/blog" class="text-sm font-semibold text-ember-600 hover:text-ember-700 transition flex items-center gap-1">
          Baca Artikel Lainnya &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {articles.slice(0, 2).map((article) => (
          <article class="card p-8 bg-paper-50 space-y-4">
            <span class="text-xs font-semibold text-noir-500">{article.published_date}</span>
            <h3 class="font-display text-2xl font-normal text-noir-900 hover:text-ember-600 transition">
              <a href={`/blog/${article.id}`}>{article.title}</a>
            </h3>
            <p class="text-sm text-noir-700 leading-relaxed line-clamp-3">{article.content}</p>
            <div class="pt-2">
              <a href={`/blog/${article.id}`} class="text-xs font-semibold text-ember-600 hover:underline">Baca Selengkapnya &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

</Base>
