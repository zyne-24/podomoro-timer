---
// Timer card markup. IDs are locked by the T1->T2 contract so timer.js can bind.
const initial = '25:00';
---

<section id="timer-card" class="mx-auto mt-16 w-full max-w-card rounded-lg border-2 border-taupe bg-surface p-8 shadow-card">
  <p id="mode-label" class="text-center text-lg font-bold tracking-[0.15em] text-leaf">
    FOKUS
  </p>
  <div class="mx-auto mt-2 h-1 w-24 rounded-pill bg-leaf-soft"></div>

  <p id="time-display" class="mt-10 text-center text-display font-bold leading-tight text-ink">
    {initial}
  </p>

  <div class="mx-auto mt-6 h-3 w-full max-w-[300px] overflow-hidden rounded-pill bg-surface">
    <div id="progress-bar" class="h-full rounded-pill bg-leaf transition-[width] duration-250 ease-linear" style="width:0%"></div>
  </div>

  <div class="mt-10 flex items-center justify-center gap-3">
    <button
      id="btn-start"
      class="rounded-pill bg-terracotta px-8 py-3 text-base font-bold text-bg shadow-soft transition hover:opacity-90"
      type="button"
    >Start</button>
    <button
      id="btn-pause"
      class="rounded-pill border-2 border-brown bg-surface px-8 py-3 text-base font-bold text-brown transition hover:opacity-90"
      type="button"
    >Pause</button>
    <button
      id="btn-reset"
      class="rounded-pill border-2 border-taupe bg-surface px-6 py-3 text-base font-bold text-muted transition hover:opacity-90"
      type="button"
    >Reset</button>
  </div>
</section>

<script>
  import '../scripts/timer.js';
</script>
